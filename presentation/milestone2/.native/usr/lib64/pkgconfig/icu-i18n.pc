# CFLAGS contains only anything end users should set
CFLAGS =  -std=c11
# CXXFLAGS contains only anything end users should set
CXXFLAGS =  -std=c++17
# DEFS only contains those UCONFIG_CPPFLAGS which are not auto-set by platform.h
DEFS = 
prefix = /usr
exec_prefix = /usr
#bindir = /usr/bin
libdir = /usr/lib64
includedir = /usr/include
baselibs = -lpthread -lm 
#datarootdir = ${prefix}/share
#datadir = /usr/share
#sbindir = /usr/bin
#mandir = /usr/share/man
#sysconfdir = /etc
UNICODE_VERSION=16.0
ICUPREFIX=icu
ICULIBSUFFIX=
LIBICU=lib${ICUPREFIX}
#SHAREDLIBCFLAGS=-fPIC
pkglibdir=${libdir}/icu${ICULIBSUFFIX}/77.1
#pkgdatadir=${datadir}/icu${ICULIBSUFFIX}/77.1
ICUDATA_NAME = icudt77l
#ICUPKGDATA_DIR=/usr/lib64
#ICUDATA_DIR=${pkgdatadir}
ICUDESC=International Components for Unicode

Version: 77.1
Cflags: -I${includedir}
# end of icu.pc.in
Description: International Components for Unicode: Internationalization library
Name: icu-i18n
Requires.private: icu-uc
Libs: -L${libdir} -licui18n
