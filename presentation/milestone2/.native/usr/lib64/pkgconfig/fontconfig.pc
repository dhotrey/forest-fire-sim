prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

sysconfdir=/etc
localstatedir=/var
confdir=/etc/fonts
cachedir=/usr/lib/fontconfig/cache

Name: Fontconfig
Description: Font configuration and customization library
Version: 2.17.0
Requires.private: freetype2 >=  21.0.15, libxml-2.0
Libs: -L${libdir} -lfontconfig
Libs.private: -pthread -lm
Cflags: -I${includedir}
